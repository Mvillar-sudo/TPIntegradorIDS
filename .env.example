# Copiar este archivo como ".env" y completar. El ".env" NO se sube a GitHub.

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=centro_medico
DB_USER=
DB_PASSWORD=

# JWT (cualquier string largo y aleatorio)
JWT_SECRET_KEY=

# Mail: cuenta de Gmail del proyecto + "contraseña de aplicación" (no la contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# URL base del frontend (la usa el botón "Cancelar turno" del mail)
FRONTEND_URL=http://127.0.0.1:3000
